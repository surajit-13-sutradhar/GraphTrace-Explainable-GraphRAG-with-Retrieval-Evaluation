# Copy this file to .env and fill in your key. NEVER commit .env.
GEMINI_API_KEY=
# Model ID; run scripts/check_gemini.py to see which models your key can use.
GEMINI_MODEL=gemini-3.1-flash-lite
# Max Gemini requests per minute we allow ourselves (stay under your tier's limit)
GEMINI_RPM=12

GEMINI_JUDGE_MODEL=gemini-3.5-flash-lite
GEMINI_JUDGE_RPM=12